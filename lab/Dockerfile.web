FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt /app/requirements.txt
COPY lab/requirements.txt /app/lab/requirements.txt
RUN python -m pip install --no-cache-dir -r lab/requirements.txt
COPY sqli.py /app/sqli.py
COPY sqli_tool /app/sqli_tool
COPY lab/app.py lab/smoke.py lab/request.http /app/lab/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
EXPOSE 5080
CMD ["python", "-m", "lab.app"]
